[global]
repo1-type=s3
repo1-path=/thalion/database
repo1-s3-endpoint=s3.example.test
repo1-s3-bucket=thalion-db-backups
repo1-s3-region=example-region
repo1-s3-uri-style=host
repo1-cipher-type=aes-256-cbc
repo1-retention-full=14
archive-async=n
lock-path=/var/spool/pgbackrest/lock
start-fast=y

[thalion]
pg1-path=/var/lib/postgresql/18/main
pg1-socket-path=/var/run/postgresql
pg1-port=5432
