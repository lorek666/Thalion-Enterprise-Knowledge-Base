THALION_BACKUP_STANZA=thalion
THALION_BACKUP_STATE_DIR=/var/lib/thalion-backup
THALION_BACKUP_OBJECT_REMOTE=originals:thalion-originals-production
PGDATABASE=thalion
PGHOST=/var/run/postgresql
PGPORT=5432
RCLONE_CONFIG=/etc/thalion/backup-rclone.conf
RESTIC_REPOSITORY=s3:https://s3.example.test/thalion-originals-backups
RESTIC_PASSWORD_FILE=/etc/thalion/secrets/restic-password
RESTIC_CACHE_DIR=/var/lib/thalion-backup/restic-cache
