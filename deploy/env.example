# Thalion 企业知识库环境变量示例（已脱敏，严禁写入真实口令、令牌或企业资料）
# 复制到受保护位置（chmod 0600），例如 /etc/thalion/thalion.env，切勿提交到仓库。

# ============================================================================
# 一、本机隔离合成模式（synthetic_local）
# ============================================================================
THALION_MODE=synthetic_local

# 隔离合成 PostgreSQL 连接信息（仅允许指向本机回环地址 127.0.0.1 / localhost / ::1）
THALION_POSTGRES_USER=thalion
THALION_POSTGRES_DB=thalion_synthetic
THALION_POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_DB_PASSWORD
THALION_DB_PORT=5432
THALION_APP_PORT=8765
THALION_DATABASE_URL=postgresql://thalion:REPLACE_WITH_LOCAL_DB_PASSWORD@127.0.0.1:5432/thalion_synthetic

# 私有合成权限目录与原件目录（目录须为 0700，内部 JSON 文件须为 0600，属主须为服务运行用户）
THALION_SYNTHETIC_PROFILE_DIR=/var/lib/thalion/profile
THALION_SYNTHETIC_ORIGINALS_DIR=/var/lib/thalion/originals
# 可选：合成备份目录（如启用，须为独立 0700 目录且不得与 originals 目录重叠）
# THALION_SYNTHETIC_BACKUPS_DIR=/var/lib/thalion/backups

# 可选：独立合成源端撤权权威（必须成对配置，且仅限回环地址）
# THALION_SOURCE_AUTHORITY_URL=postgresql://thalion:REPLACE_WITH_AUTH_DB_PASSWORD@127.0.0.1:5433/thalion_authority
# THALION_SOURCE_AUTHORITY_REF=00000000-0000-4000-8000-000000000901

# 可选：运行告警巡检的目标合成空间 UUID
THALION_ALERT_SPACE_ID=00000000-0000-4000-8000-000000000201

# 可选：离线构建后的本地容器镜像标签
THALION_APP_IMAGE=thalion-enterprise-kb:local

# ============================================================================
# 二、生产模式配置引用示例（production，待 E01 签认及 X01–X06 真实集成后启用）
# 说明：validate_deployment_config 强制生产模式只接受间接密钥引用（env:/vault:/kms:/file:），
# 拒绝明文凭据、非 HTTPS 端点以及 synthetic/localhost/loopback 主机名。
# ============================================================================
# THALION_BUSINESS_TIMEZONE=Asia/Shanghai
# THALION_DATABASE_URL_REF=vault:thalion/prod/database-url
# THALION_ALLOWED_HOSTS=kb.corp.example
# 可选：Prometheus 抓取 /metrics 使用的专用随机令牌；不设置则不开放指标。允许标准 base64 令牌中的 =。
# THALION_METRICS_TOKEN_REF=file:/etc/thalion/secrets/metrics-token
# Docker 健康探针读取 THALION_APP_PORT；若 --port 另有覆盖，需同时设置 THALION_HEALTHCHECK_PORT。
# 可选：生产 thalion-worker 将积压和恢复通知发往 HTTPS Webhook。URL 和令牌都通过私有引用读取。
# THALION_ALERT_WEBHOOK_URL_REF=file:/etc/thalion/secrets/alert-webhook-url
# THALION_ALERT_WEBHOOK_TOKEN_REF=file:/etc/thalion/secrets/alert-webhook-token
# 生产后台 worker 默认每 300 秒巡检一次，也可以在 systemd 单元里调整 --interval-seconds。
# THALION_OIDC_ISSUER=https://idp.corp.example
# THALION_OIDC_AUDIENCE=thalion-kb
# THALION_OIDC_JWKS_URL=https://idp.corp.example/.well-known/jwks.json
# THALION_SOURCE_AUTHORITY_ENDPOINT=https://source-auth.corp.example/v1/check
# THALION_SOURCE_AUTHORITY_CREDENTIAL_REF=vault:thalion/prod/source-auth
# THALION_SOURCE_AUTHORITY_REF=00000000-0000-4000-8000-000000000901
# THALION_OBJECT_STORAGE_ENDPOINT=https://object.corp.example
# THALION_OBJECT_STORAGE_BUCKET=thalion-originals-prod
# THALION_OBJECT_STORAGE_CREDENTIAL_REF=vault:thalion/prod/object-storage
# 默认 thalion，使用现有 HTTPS 网关；S3 直连时改为 s3，并配置以下选项。
# THALION_OBJECT_STORAGE_PROTOCOL=thalion

# S3 直连：以下任选一个平台，替换上面的对象存储设置。
# 凭据引用指向受保护的 JSON：{"access_key_id":"REPLACE_WITH_ID","secret_access_key":"REPLACE_WITH_SECRET"}
# 阿里云 OSS（须使用从未开启版本控制的通用桶）：
# THALION_OBJECT_STORAGE_PROTOCOL=s3
# THALION_OBJECT_STORAGE_S3_PROVIDER=aliyun_oss
# THALION_OBJECT_STORAGE_ENDPOINT=https://s3.oss-cn-hangzhou.aliyuncs.com
# THALION_OBJECT_STORAGE_REGION=cn-hangzhou
# THALION_OBJECT_STORAGE_BUCKET=thalion-originals-prod
# THALION_OBJECT_STORAGE_ADDRESSING_STYLE=virtual
# 新账号若须使用已绑定该桶的 HTTPS 自定义域名，用该域名作为 Endpoint，访问风格改为 bucket。
# 腾讯云 COS（须使用从未开启版本控制的标准桶）：
# THALION_OBJECT_STORAGE_PROTOCOL=s3
# THALION_OBJECT_STORAGE_S3_PROVIDER=tencent_cos
# THALION_OBJECT_STORAGE_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
# THALION_OBJECT_STORAGE_REGION=ap-guangzhou
# THALION_OBJECT_STORAGE_BUCKET=thalion-originals-1250000000
# THALION_OBJECT_STORAGE_ADDRESSING_STYLE=virtual

# THALION_SECURITY_AUDIT_ENDPOINT=https://audit-sink.corp.example/v1/events
# THALION_SECURITY_AUDIT_CREDENTIAL_REF=vault:thalion/prod/audit-sink
# THALION_SECURITY_AUDIT_LOG_REF=00000000-0000-4000-8000-000000000902
# THALION_SOURCE_CONNECTOR_ENDPOINT=https://connector.corp.example/v1
# THALION_SOURCE_CONNECTOR_CREDENTIAL_REF=vault:thalion/prod/source-connector
# THALION_SOURCE_CONNECTOR_SYSTEM=corp-confluence
# 多来源接入改用私有 JSON 映射；三个全局 THALION_SOURCE_CONNECTOR_* 项不再设置。
# THALION_SOURCE_CONNECTOR_MAP_REF=file:/etc/thalion/source-connectors.json
# JSON 以本地来源 UUID 为键；Confluence 的 space_id 是数字空间编号，不是可读的空间简称。
# {"00000000-0000-4000-8000-000000000301":{"type":"confluence_cloud","endpoint":"https://tenant.atlassian.net/wiki","credential_ref":"file:/etc/thalion/secrets/confluence-token","account":"sync@example.test","space_id":"12345"}}
# 受限范围 API Token 用 https://api.atlassian.com/ex/confluence/<cloud-id>/wiki。
# 飞书知识库用 type=feishu_wiki、endpoint、credential_ref、app_id、space_id；credential_ref 指向 app_secret。
# {"00000000-0000-4000-8000-000000000302":{"type":"feishu_wiki","endpoint":"https://open.feishu.cn","credential_ref":"file:/etc/thalion/secrets/feishu-app-secret","app_id":"cli_example","space_id":"space_example"}}
# SharePoint 文档库用 type=sharepoint_graph、endpoint、credential_ref、drive_id；credential_ref 指向 Microsoft Graph bearer token。
# {"00000000-0000-4000-8000-000000000303":{"type":"sharepoint_graph","endpoint":"https://graph.microsoft.com/v1.0","credential_ref":"file:/etc/thalion/secrets/graph-token","drive_id":"b!example"}}
# 通用连接器用 type=http、endpoint、credential_ref、source_system 四个字段。
# 生产 worker 用 --interval-seconds 配置轮询；Confluence 建议至少 300 秒，文档越多间隔越长。
# THALION_MODEL_GATEWAY_ENDPOINT=https://llm-gateway.corp.example/v1
# THALION_MODEL_GATEWAY_CREDENTIAL_REF=vault:thalion/prod/model-gateway
# THALION_MODEL_GATEWAY_PROTOCOL=openai_compatible
# THALION_MODEL_GATEWAY_MODEL=deepseek-v4.1-flash
# THALION_MODEL_GATEWAY_DESTINATION=corp-llm-gateway
# THALION_MODEL_GATEWAY_PURPOSES=wiki_compilation,model_answer
# THALION_MODEL_GATEWAY_TIMEOUT_SECONDS=60
# THALION_MODEL_GATEWAY_MAX_TOKENS=4096
# THALION_EMBEDDING_ENDPOINT=https://embedding.corp.example/v1
# THALION_EMBEDDING_CREDENTIAL_REF=vault:thalion/prod/embedding
# THALION_EMBEDDING_PROTOCOL=openai_compatible
# THALION_EMBEDDING_MODEL_ID=corp-embed-v1
# THALION_EMBEDDING_DIMENSION=1024
# THALION_EMBEDDING_REQUEST_DIMENSIONS=true
# THALION_EMBEDDING_PASSAGE_INPUT_TYPE=passage
# THALION_EMBEDDING_QUERY_INPUT_TYPE=query
# THALION_EMBEDDING_TIMEOUT_SECONDS=30

# 可选：浏览器企业 OIDC Authorization Code + PKCE 单点登录（员工页与 15 个管理工作台）
# THALION_OIDC_AUTHORIZATION_ENDPOINT=https://idp.corp.example/oauth2/authorize
# THALION_OIDC_TOKEN_ENDPOINT=https://idp.corp.example/oauth2/token
# THALION_OIDC_CLIENT_ID=thalion-kb-web
# THALION_OIDC_REDIRECT_URI=https://kb.corp.example/auth/oidc/callback
# THALION_OIDC_SCOPES=openid profile
# THALION_OIDC_CLIENT_SECRET_REF=vault:thalion/prod/oidc-client-secret
# THALION_OIDC_TOKEN_AUTH_METHOD=client_secret_post
# 标准企业身份令牌使用私有组映射，不需要在身份平台添加 space_ref、operations 等字段。
# THALION_OIDC_ACCESS_MAP_FILE=/etc/thalion/oidc-access.json
# 文件属主为运行用户，权限 0600。以下为一行 JSON 示例，不能填真实企业数据后提交：
# {"issuer":"https://idp.corp.example","client_id":"thalion-kb-web","group_claim":"groups","groups":{"kb-readers":{"space_ref":"00000000-0000-4000-8000-000000000201","operations":["search","read_passage"]}}}
# Keycloak 可将 group_claim 设为 realm_access.roles。每个组键须和签名 ID Token 里的值完全一致。
# 用户须已按 (issuer, sub) 登记为员工；组映射须指向该员工组织内唯一的启用空间。
